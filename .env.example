# Discord
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_USER_ID=your_discord_user_id_here
DISCORD_USER_ID_2=optional_second_user_id
DISCORD_BOTS_ID=alias:bot_user_id_here,other_alias:another_bot_id
DISCORD_GUILD_ID=optional_target_guild_id

# Discord OAuth2
DISCORD_CLIENT_ID=
